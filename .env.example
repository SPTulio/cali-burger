# Copie para ".env" e ajuste se quiser. O .env não vai para o Git.

# Porta do site no seu computador (http://localhost:8080)
PORTA_WEB=8080
# Porta do MySQL no seu computador (para abrir com DBeaver, Workbench etc.)
PORTA_MYSQL=3307

DB_USUARIO=caliburger
DB_SENHA=caliburger
DB_SENHA_ROOT=troque-esta-senha

# 1 = mostra erros detalhados do PHP na tela (somente em desenvolvimento)
MODO_DEBUG=0
# 1 = mostra as contas de demonstração nas telas de login
MOSTRAR_CONTAS_DEMO=1
